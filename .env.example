APP_ENV=local

POSTGRES_USER=codemate
POSTGRES_PASSWORD=codemate
POSTGRES_DB=codemate

DATABASE_URL=postgresql+psycopg://codemate:codemate@postgres:5432/codemate
DATABASE_MIGRATIONS_ENABLED=true
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=codemate_chunks

FRONTEND_URL=http://localhost:3000
API_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
BACKEND_API_BASE_URL=http://localhost:8000
EVALUATION_ADMIN_TOKEN=
EVALUATION_CI_TOKEN=
EVALUATION_READ_TOKEN=
CODEMATE_EVALUATION_API_TOKEN=
CODEMATE_PROXY_IDENTITY_SECRET=
CODEMATE_PROXY_IDENTITY_PREVIOUS_SECRET=
CODEMATE_PROXY_IDENTITY_TTL_SECONDS=300
CODEMATE_PROXY_IDENTITY_NONCE_STORE=redis
CODEMATE_REQUIRE_SIGNED_BROWSER_IDENTITY=false
FRONTEND_ADMIN_PASSWORD=
FRONTEND_ADMIN_SESSION_SECRET=
SECURITY_AUDIT_LOG_PATH=artifacts/security/events.jsonl
# Staging/production: true, with both http and s3 sinks.
SECURITY_AUDIT_EXPORT_REQUIRED=false
SECURITY_AUDIT_FAIL_CLOSED=false
SECURITY_AUDIT_INGEST_TOKEN=
SECURITY_AUDIT_INGEST_URL=
SECURITY_AUDIT_SINKS=
SECURITY_AUDIT_SIEM_URL=
SECURITY_AUDIT_SIEM_HMAC_SECRET=
SECURITY_AUDIT_S3_BUCKET=
SECURITY_AUDIT_S3_PREFIX=codemate/security-audit
SECURITY_AUDIT_S3_RETENTION_DAYS=365
SECURITY_AUDIT_DELIVERY_INTERVAL_SECONDS=15
SECURITY_AUDIT_DELIVERY_BATCH_SIZE=100
SECURITY_AUDIT_DELIVERY_MAX_ATTEMPTS=12
SECURITY_AUDIT_DELIVERY_LEASE_SECONDS=60
SECURITY_AUDIT_OUTBOX_RETENTION_DAYS=90
AWS_REGION=
# Only set for an emulator such as LocalStack; leave empty for AWS.
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
CODEMATE_RBAC_ADMIN_USERS=
CODEMATE_RBAC_ADMIN_TEAMS=
CODEMATE_RBAC_VIEWER_USERS=
CODEMATE_RBAC_VIEWER_TEAMS=
CODEMATE_RBAC_VIEWER_ORGS=

WORKSPACE_DIR=/app/workspaces
RQ_QUEUE_NAME=codemate-index
RQ_WORKER_READINESS_REQUIRED=false
RQ_WORKER_HEARTBEAT_INTERVAL_SECONDS=5
RQ_WORKER_HEARTBEAT_TTL_SECONDS=20
RQ_WORKER_HEARTBEAT_PREFIX=codemate:rq:worker:heartbeat
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=60
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_CONTEXT_CHARS=24000
LLM_MAX_OUTPUT_TOKENS=4096
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
RETRIEVAL_TOP_K=8
# Supported benchmark modes: vector, hybrid. Production default is hybrid.
RETRIEVAL_STRATEGY=hybrid
RETRIEVAL_MIN_VECTOR_SCORE=0.72
RETRIEVAL_CANDIDATE_MULTIPLIER=4
RETRIEVAL_RERANK_ENABLED=true
RETRIEVAL_CONTEXT_EXPANSION_ENABLED=true
RETRIEVAL_CONTEXT_WINDOW=1
RETRIEVAL_CONTEXT_MAX_EXTRA=4
MULTI_REPO_TOP_K=12
MULTI_REPO_MAX_REPOS=8
REVIEW_CONTEXT_TOP_K=10
REVIEW_MAX_DIFF_CHARS=60000
REPO_MEMORY_MAX_FILES=12
REPO_MEMORY_MAX_SYMBOLS=30
CI_WORKFLOW_FILENAME=codemate-ci.yml
MCP_ENABLED=true
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Empty means every repository. Otherwise use comma-separated repository UUIDs.
MCP_ALLOWED_REPO_IDS=
MCP_MAX_FILE_LINES=500
MCP_CLIENT_ENABLED=false
MCP_CLIENT_API_TOKEN=
# Default external-server credential; reference this name from bearer_token_env.
MCP_CLIENT_BEARER_TOKEN=
MCP_CLIENT_SERVERS_JSON=[]
MCP_CLIENT_TIMEOUT_SECONDS=20
MCP_CLIENT_MAX_RESULT_CHARS=50000
MCP_SANDBOX_ENABLED=false
MCP_SANDBOX_BROKER_MODE=false
MCP_SANDBOX_BROKER_URL=
MCP_SANDBOX_BROKER_TOKEN=
MCP_EGRESS_PROXY_URL=
MCP_EGRESS_PROXY_TOKEN=
MCP_EGRESS_ALLOWED_PORTS=443
MCP_EGRESS_CONNECT_TIMEOUT_SECONDS=10
MCP_COMPLIANCE_ENABLED=false
MCP_COMPLIANCE_INTERVAL_SECONDS=300
MCP_COMPLIANCE_STALE_SECONDS=900
MCP_COMPLIANCE_REPORT_PATH=artifacts/compliance/mcp-compliance-latest.json
MCP_COMPLIANCE_RETENTION_DAYS=90
MCP_TOOL_ROUTER_ENABLED=true
MCP_TOOL_ROUTER_MAX_ROUNDS=2
MCP_TOOL_ROUTER_MAX_CALLS_PER_RUN=4
MCP_TOOL_ROUTER_MAX_CATALOG_TOOLS=64
MCP_APPROVAL_ENABLED=true
MCP_APPROVAL_TTL_SECONDS=1800
MCP_APPROVAL_RESUME_STALE_SECONDS=300
MCP_APPROVAL_MAX_CHECKPOINT_CHARS=2000000
MCP_EXECUTION_LEASE_SECONDS=60
MCP_EXECUTION_MAX_ATTEMPTS=3
MCP_EXECUTION_MAX_CHECKPOINT_CHARS=2000000
MCP_OBSERVABILITY_WINDOW_MINUTES=60
MCP_HEALTH_MONITOR_ENABLED=true
MCP_HEALTH_PROBE_INTERVAL_SECONDS=60
MCP_HEALTH_STALE_SECONDS=180
MCP_CIRCUIT_BREAKER_ENABLED=true
MCP_CIRCUIT_FAILURE_THRESHOLD=3
MCP_CIRCUIT_COOLDOWN_SECONDS=60
MCP_CIRCUIT_HALF_OPEN_LEASE_SECONDS=30
MCP_ALERT_UNKNOWN_AGE_SECONDS=300
MCP_ALERT_ERROR_RATE_THRESHOLD=0.5
MCP_ALERT_MINIMUM_CALLS=5
MCP_REGISTRY_ENABLED=true
# Local development uses a derived envelope key. Staging/production must use aws.
MCP_REGISTRY_KMS_PROVIDER=local
MCP_REGISTRY_KMS_KEY_ID=
# Only used by local KMS and temporarily while migrating legacy ciphertext.
MCP_REGISTRY_MASTER_KEY=
MCP_REGISTRY_PREVIOUS_MASTER_KEY=
MCP_REGISTRY_KEY_VERSION=1
MCP_REGISTRY_MAX_SERVERS=64
MCP_REGISTRY_ALLOWED_HOSTS=
MCP_REGISTRY_ALLOW_PRIVATE_NETWORKS=false
MCP_REGISTRY_REQUIRE_HTTPS=true
MCP_OAUTH_TOKEN_EXPIRY_SKEW_SECONDS=60
MCP_TENANT_AUTHORIZATION_ENABLED=false
MCP_DEFAULT_TENANT_SLUG=default
MCP_DELEGATED_OAUTH_STATE_TTL_SECONDS=600
MCP_QUOTA_ENABLED=false
MCP_QUOTA_BACKEND=redis
MCP_QUOTA_FAIL_CLOSED=true
MCP_QUOTA_REDIS_PREFIX=codemate:mcp:quota
MCP_QUOTA_CONCURRENCY_LEASE_SECONDS=180
MCP_QUOTA_MAX_POLICIES_PER_TENANT=64
MCP_QUOTA_DEFAULT_CALL_COST_UNITS=1
MCP_QUOTA_REJECTION_ALERT_THRESHOLD=5
MCP_QUOTA_RETENTION_DAYS=90
MCP_QUOTA_RECONCILIATION_INTERVAL_SECONDS=300
OTEL_ENABLED=false
OTEL_SERVICE_NAME=codemate-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
MAX_AGENT_ITERATIONS=3
# adaptive lets the model choose structured actions; fixed is reserved for benchmark ablation.
AGENT_PLANNER_MODE=adaptive
AGENT_MAX_LOCAL_TOOL_CALLS=12
AGENT_MAX_PLANNER_CALLS=16
AGENT_MAX_PLANNER_TOKENS=24000
AGENT_MAX_LOOP_SECONDS=600
AGENT_MAX_NO_PROGRESS_STEPS=3
AGENT_MAX_READ_LINES=800
AGENT_MAX_EVIDENCE_ITEMS=40
AGENT_MAX_ACTION_HISTORY=64
# Optional blended rate used only to estimate benchmark cost. Leave empty when unknown.
EVALUATION_LLM_COST_PER_MILLION_TOKENS_USD=
SANDBOX_WORKSPACE_DIR=/tmp/codemate-runs
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_NETWORK_DISABLED=true
SANDBOX_RUNTIME=docker
SANDBOX_GVISOR_DOCKER_RUNTIME=runsc
SANDBOX_FIRECRACKER_COMMAND_TEMPLATE=
SANDBOX_NODE_IMAGE=node:20-alpine
SANDBOX_PYTHON_IMAGE=python:3.11-slim
SANDBOX_ALLOWED_COMMANDS=npm test,npm run test:health,pnpm test,yarn test,pytest,python -m pytest,python -m unittest discover,python -m unittest tests.test_health
SANDBOX_EXECUTION_BROKER_URL=
SANDBOX_EXECUTION_BROKER_TOKEN=
SANDBOX_DOCKER_WORKSPACE_VOLUME=
SANDBOX_EXECUTION_PLANE_ENABLED=false
SANDBOX_EXECUTION_PLANE_URL=
SANDBOX_EXECUTION_PLANE_BACKEND=firecracker
SANDBOX_EXECUTION_PLANE_CA_PATH=
SANDBOX_EXECUTION_PLANE_CERT_PATH=
SANDBOX_EXECUTION_PLANE_KEY_PATH=
SANDBOX_EXECUTION_PLANE_PROXY_URL=
SANDBOX_WORKLOAD_IDENTITY_ISSUER=codemate
SANDBOX_WORKLOAD_IDENTITY_SUBJECT=spiffe://codemate/code-sandbox
SANDBOX_WORKLOAD_IDENTITY_AUDIENCE=codemate-sandbox-execution-plane
SANDBOX_WORKLOAD_IDENTITY_PRIVATE_KEY_PATH=
SANDBOX_WORKLOAD_IDENTITY_PUBLIC_KEY_PATH=
SANDBOX_WORKLOAD_IDENTITY_TTL_SECONDS=60
SANDBOX_WORKSPACE_ARCHIVE_MAX_BYTES=16777216
SANDBOX_WORKSPACE_ARCHIVE_MAX_FILES=10000
SANDBOX_EXECUTION_OUTPUT_MAX_CHARS=200000
SANDBOX_FIRECRACKER_RUNNER_COMMAND_JSON=
SANDBOX_KUBERNETES_NAMESPACE=codemate-sandbox
SANDBOX_KUBERNETES_WORKSPACE_ROOT=/var/lib/codemate/workspaces
SANDBOX_KUBERNETES_PVC_NAME=codemate-sandbox-workspaces
SANDBOX_KUBECTL_PATH=kubectl
SANDBOX_KUBERNETES_NODE_SELECTOR_JSON={"codemate.io/attested-sandbox-node":"true"}
# HA execution planes must use a highly available Redis/Valkey endpoint.
SANDBOX_EXECUTION_STATE_BACKEND=memory
SANDBOX_EXECUTION_STATE_REDIS_URL=
SANDBOX_EXECUTION_STATE_PREFIX=codemate:sandbox:execution
SANDBOX_EXECUTION_STATE_RETENTION_SECONDS=86400
SANDBOX_EXECUTION_LEASE_GRACE_SECONDS=60
SANDBOX_EXECUTION_CLIENT_MAX_ATTEMPTS=3
SANDBOX_SUPPLY_CHAIN_ENABLED=false
SANDBOX_SUPPLY_CHAIN_COSIGN_PATH=cosign
SANDBOX_SUPPLY_CHAIN_PUBLIC_KEY_PATH=
SANDBOX_SUPPLY_CHAIN_CERTIFICATE_IDENTITY_REGEXP=
SANDBOX_SUPPLY_CHAIN_CERTIFICATE_OIDC_ISSUER=
SANDBOX_SUPPLY_CHAIN_REQUIRE_IMAGE_DIGEST=true
SANDBOX_SUPPLY_CHAIN_REQUIRE_SLSA=true
SANDBOX_SUPPLY_CHAIN_SLSA_SOURCE=
SANDBOX_SUPPLY_CHAIN_SLSA_BUILDER_ID=
SANDBOX_FIRECRACKER_ROOTFS_PATH=
SANDBOX_FIRECRACKER_ROOTFS_BUNDLE_PATH=
SANDBOX_FIRECRACKER_ROOTFS_SHA256=
SANDBOX_NODE_ATTESTATION_ENABLED=false
SANDBOX_NODE_ATTESTATION_DOCUMENT_PATH=
SANDBOX_NODE_ATTESTATION_PUBLIC_KEY_PATH=
SANDBOX_NODE_ATTESTATION_EXPECTED_NODE_ID=
SANDBOX_NODE_ATTESTATION_VERIFIER_COMMAND_JSON=
SANDBOX_NODE_ATTESTATION_VERIFIER_TIMEOUT_SECONDS=15
SANDBOX_NODE_ATTESTATION_ALLOWED_TEE_TYPES=tpm2,sev-snp,tdx,nitro
SANDBOX_NODE_ATTESTATION_ALLOWED_MEASUREMENTS=
SANDBOX_NODE_ATTESTATION_MAX_AGE_SECONDS=300

# Default providers are mock and do not require model keys.
# OpenAI example:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=384
# OPENAI_API_KEY=sk-...
#
# DeepSeek LLM + OpenAI embeddings example:
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# DEEPSEEK_API_KEY=sk-...
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
#
# OpenAI-compatible custom endpoint example:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_MODEL=your-chat-model
# LLM_API_KEY=...
# EMBEDDING_PROVIDER=openai-compatible
# EMBEDDING_BASE_URL=https://your-provider.example/v1
# EMBEDDING_MODEL=your-embedding-model
# EMBEDDING_DIMENSION=1024
# EMBEDDING_API_KEY=...
