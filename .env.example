APP_ENV=local

POSTGRES_USER=codemate
POSTGRES_PASSWORD=codemate
POSTGRES_DB=codemate

DATABASE_URL=postgresql+psycopg://codemate:codemate@postgres:5432/codemate
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=codemate_chunks

FRONTEND_URL=http://localhost:3000
API_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

WORKSPACE_DIR=/app/workspaces
RQ_QUEUE_NAME=codemate-index
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=60
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_CONTEXT_CHARS=24000
LLM_MAX_OUTPUT_TOKENS=4096
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_VECTOR_SCORE=0.72
RETRIEVAL_CANDIDATE_MULTIPLIER=4
RETRIEVAL_RERANK_ENABLED=true
RETRIEVAL_CONTEXT_EXPANSION_ENABLED=true
RETRIEVAL_CONTEXT_WINDOW=1
RETRIEVAL_CONTEXT_MAX_EXTRA=4
MULTI_REPO_TOP_K=12
MULTI_REPO_MAX_REPOS=8
REVIEW_CONTEXT_TOP_K=10
REVIEW_MAX_DIFF_CHARS=60000
REPO_MEMORY_MAX_FILES=12
REPO_MEMORY_MAX_SYMBOLS=30
CI_WORKFLOW_FILENAME=codemate-ci.yml
MAX_AGENT_ITERATIONS=3
SANDBOX_WORKSPACE_DIR=/tmp/codemate-runs
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_NETWORK_DISABLED=true
SANDBOX_RUNTIME=docker
SANDBOX_GVISOR_DOCKER_RUNTIME=runsc
SANDBOX_FIRECRACKER_COMMAND_TEMPLATE=
SANDBOX_NODE_IMAGE=node:20-alpine
SANDBOX_PYTHON_IMAGE=python:3.11-slim
SANDBOX_ALLOWED_COMMANDS=npm test,pnpm test,yarn test,pytest,python -m pytest

# Default providers are mock and do not require model keys.
# OpenAI example:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=384
# OPENAI_API_KEY=sk-...
#
# DeepSeek LLM + OpenAI embeddings example:
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# DEEPSEEK_API_KEY=sk-...
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
#
# OpenAI-compatible custom endpoint example:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_MODEL=your-chat-model
# LLM_API_KEY=...
# EMBEDDING_PROVIDER=openai-compatible
# EMBEDDING_BASE_URL=https://your-provider.example/v1
# EMBEDDING_MODEL=your-embedding-model
# EMBEDDING_DIMENSION=1024
# EMBEDDING_API_KEY=...
