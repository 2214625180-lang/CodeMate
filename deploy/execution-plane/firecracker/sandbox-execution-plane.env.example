APP_ENV=production
SANDBOX_EXECUTION_PLANE_BACKEND=firecracker
SANDBOX_WORKSPACE_DIR=/var/lib/codemate/workspaces
SANDBOX_FIRECRACKER_RUNNER_COMMAND_JSON=["/usr/local/bin/codemate-firecracker-runner","--workspace","{workspace}","--image","{image}","--command","{command}","--timeout","{timeout}","--execution-id","{execution_id}"]
SANDBOX_WORKLOAD_IDENTITY_ISSUER=codemate-staging
SANDBOX_WORKLOAD_IDENTITY_SUBJECT=spiffe://codemate/staging/code-sandbox
SANDBOX_WORKLOAD_IDENTITY_AUDIENCE=codemate-sandbox-execution-plane
SANDBOX_WORKLOAD_IDENTITY_PUBLIC_KEY_PATH=/etc/codemate/identity/workload-signing.pub
SANDBOX_NODE_IMAGE=registry.example.com/codemate/node-test@sha256:replace-with-64-hex-digest
SANDBOX_PYTHON_IMAGE=registry.example.com/codemate/python-test@sha256:replace-with-64-hex-digest
SANDBOX_ALLOWED_COMMANDS=npm test,pnpm test,yarn test,pytest,python -m pytest
SANDBOX_EXECUTION_STATE_BACKEND=redis
SANDBOX_EXECUTION_STATE_REDIS_URL=rediss://replace-with-ha-redis-endpoint:6379/0
SANDBOX_EXECUTION_STATE_RETENTION_SECONDS=86400
SANDBOX_SUPPLY_CHAIN_ENABLED=true
SANDBOX_SUPPLY_CHAIN_COSIGN_PATH=/usr/local/bin/cosign
SANDBOX_SUPPLY_CHAIN_PUBLIC_KEY_PATH=/etc/codemate/supply-chain/cosign.pub
SANDBOX_SUPPLY_CHAIN_REQUIRE_IMAGE_DIGEST=true
SANDBOX_SUPPLY_CHAIN_REQUIRE_SLSA=true
SANDBOX_SUPPLY_CHAIN_SLSA_SOURCE=https://github.com/replace-with-org/codemate
SANDBOX_FIRECRACKER_ROOTFS_PATH=/var/lib/codemate/images/rootfs.ext4
SANDBOX_FIRECRACKER_ROOTFS_BUNDLE_PATH=/var/lib/codemate/images/rootfs.ext4.bundle.json
SANDBOX_FIRECRACKER_ROOTFS_SHA256=replace-with-64-hex-digest
SANDBOX_NODE_ATTESTATION_ENABLED=true
SANDBOX_NODE_ATTESTATION_PUBLIC_KEY_PATH=/etc/codemate/attestation/authority.pub
SANDBOX_NODE_ATTESTATION_EXPECTED_NODE_ID=replace-with-node-id
SANDBOX_NODE_ATTESTATION_VERIFIER_COMMAND_JSON=["/usr/local/bin/codemate-node-attestation","verify","--node","{node_id}","--nonce","{nonce}"]
SANDBOX_NODE_ATTESTATION_ALLOWED_TEE_TYPES=tpm2,sev-snp,tdx,nitro
SANDBOX_NODE_ATTESTATION_ALLOWED_MEASUREMENTS=replace-with-approved-measurement
