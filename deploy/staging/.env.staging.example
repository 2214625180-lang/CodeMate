APP_ENV=staging
POSTGRES_USER=codemate
POSTGRES_PASSWORD=replace-with-secret-manager-value
POSTGRES_DB=codemate

STAGING_API_URL=https://api.staging.example.com
STAGING_FRONTEND_URL=https://staging.example.com
STAGING_API_BIND=127.0.0.1:8000
STAGING_FRONTEND_BIND=127.0.0.1:3000

RQ_WORKER_READINESS_REQUIRED=true
RQ_WORKER_HEARTBEAT_INTERVAL_SECONDS=5
RQ_WORKER_HEARTBEAT_TTL_SECONDS=20
RQ_WORKER_HEARTBEAT_PREFIX=codemate:rq:worker:heartbeat:staging

MCP_ENABLED=true
MCP_AUTH_TOKEN=replace-with-32-plus-character-secret
MCP_ALLOWED_REPO_IDS=replace-with-comma-separated-repository-ids
MCP_CLIENT_ENABLED=true
MCP_CLIENT_API_TOKEN=replace-with-32-plus-character-secret
MCP_REGISTRY_ENABLED=true
MCP_REGISTRY_KMS_PROVIDER=aws
MCP_REGISTRY_KMS_KEY_ID=alias/codemate-staging
MCP_REGISTRY_MASTER_KEY=
MCP_REGISTRY_PREVIOUS_MASTER_KEY=
MCP_REGISTRY_KEY_VERSION=2
# Include MCP endpoints, OAuth token/authorize hosts, and the OAuth redirect host.
MCP_REGISTRY_ALLOWED_HOSTS=mcp.staging.example.com,oauth.staging.example.com,staging.example.com
MCP_REGISTRY_REQUIRE_HTTPS=true
MCP_REGISTRY_ALLOW_PRIVATE_NETWORKS=false
MCP_TENANT_AUTHORIZATION_ENABLED=true
MCP_QUOTA_ENABLED=true
MCP_QUOTA_BACKEND=redis
MCP_QUOTA_FAIL_CLOSED=true
MCP_SANDBOX_ENABLED=true
MCP_SANDBOX_BROKER_TOKEN=replace-with-32-plus-character-secret
MCP_EGRESS_PROXY_TOKEN=replace-with-32-plus-character-secret
MCP_EGRESS_ALLOWED_PORTS=443
MCP_COMPLIANCE_ENABLED=true
MCP_COMPLIANCE_INTERVAL_SECONDS=300
MCP_COMPLIANCE_STALE_SECONDS=900
MCP_COMPLIANCE_RETENTION_DAYS=90
SANDBOX_EXECUTION_BROKER_TOKEN=replace-with-32-plus-character-secret
SANDBOX_EXECUTION_PLANE_URL=https://sandbox-runner.staging.example.com:8443
SANDBOX_EXECUTION_PLANE_BACKEND=firecracker
SANDBOX_NODE_IMAGE=registry.example.com/codemate/node-test@sha256:replace-with-64-hex-digest
SANDBOX_PYTHON_IMAGE=registry.example.com/codemate/python-test@sha256:replace-with-64-hex-digest
SANDBOX_MTLS_CA_FILE=/etc/codemate/sandbox-pki/ca.crt
SANDBOX_MTLS_CLIENT_CERT_FILE=/etc/codemate/sandbox-pki/code-sandbox.crt
SANDBOX_MTLS_CLIENT_KEY_FILE=/etc/codemate/sandbox-pki/code-sandbox.key
SANDBOX_WORKLOAD_PRIVATE_KEY_FILE=/etc/codemate/sandbox-pki/workload-signing.key
SANDBOX_WORKLOAD_IDENTITY_ISSUER=codemate-staging
SANDBOX_WORKLOAD_IDENTITY_SUBJECT=spiffe://codemate/staging/code-sandbox
SANDBOX_WORKLOAD_IDENTITY_AUDIENCE=codemate-sandbox-execution-plane

EVALUATION_ADMIN_TOKEN=replace-with-32-plus-character-secret
CODEMATE_PROXY_IDENTITY_SECRET=replace-with-32-plus-character-secret
CODEMATE_PROXY_IDENTITY_NONCE_STORE=redis
CODEMATE_REQUIRE_SIGNED_BROWSER_IDENTITY=true

SECURITY_AUDIT_LOG_PATH=/app/artifacts/security/events.jsonl
SECURITY_AUDIT_EXPORT_REQUIRED=true
SECURITY_AUDIT_FAIL_CLOSED=true
SECURITY_AUDIT_INGEST_TOKEN=replace-with-32-plus-character-secret
SECURITY_AUDIT_SINKS=http,s3
SECURITY_AUDIT_SIEM_URL=https://siem.example.com/codemate/events
SECURITY_AUDIT_SIEM_HMAC_SECRET=replace-with-32-plus-character-secret
SECURITY_AUDIT_S3_BUCKET=codemate-staging-security-audit
SECURITY_AUDIT_S3_PREFIX=codemate/security-audit
SECURITY_AUDIT_S3_RETENTION_DAYS=365
SECURITY_AUDIT_OUTBOX_RETENTION_DAYS=90
AWS_REGION=ap-southeast-1
# Attach an IAM role to the staging host/workload; do not use static AWS keys.

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.staging.example.com
